rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive != false) ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.isActive != false)
      );
    }

    // Admins collection:
    // No public registration.
    // An authenticated user can check their own doc (for login verification) or an active admin can read/manage.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == adminId ||
        (request.auth.token.email != null && request.auth.token.email == adminId) ||
        isAdmin()
      );
      allow write: if isAdmin() || (
        isAuthenticated() &&
        (request.auth.uid == adminId || (request.auth.token.email != null && request.auth.token.email == adminId))
      );
    }

    // Campaign collection:
    // Public can read active campaign data.
    // Target change, reset, new campaign creation, deletion: strictly restricted to active Admins.
    // Public submission increment is allowed without tampering with target/active status.
    match /campaign/{campaignId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.target == resource.data.target &&
        request.resource.data.isActive == resource.data.isActive &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.totalRecited >= resource.data.totalRecited
      );
    }

    // Submissions collection:
    // Public can read submission lists and create submissions.
    // Modifying or deleting submissions: strictly restricted to active Admins.
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if (
        request.resource.data.count is number || request.resource.data.duroodCount is number
      );
      allow update, delete: if isAdmin();
    }

    // Classes collection:
    // Public can read class rankings.
    // Managing classes: restricted to active Admins.
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stats collection:
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

